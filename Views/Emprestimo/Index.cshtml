@model  IEnumerable<EmprestimoModel>
<div class= "container">

    <div class="d-flex justify-content-between align-items-center mb-5">
		<h1>Empréstimos</h1>
        <div>
            <a class="btn btn-primary mx-2" asp-corimntroller="Emprestimo" asp-action="Exportar"><i class="bi bi-plus-square mx-2"></i>Exportar</a>
            <a class="btn btn-primary mx-2" asp-corimntroller="Emprestimo" asp-action="Cadastrar"><i class="bi bi-plus-square mx-2"></i>Cadastrar novo empréstimo</a>
        </div>
        

    </div>


    @if(TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success text-dark" role="alert">
            @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger text-dark" role="alert">
            @TempData["MensagemErro"]
        </div>
    }

    <table id="Emprestimo" class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Recebedor</th>
                <th scope="col">Fornecedor</th>
                <th scope="col">Livro</th>
                <th scope="col">UltimaAtualizacao</th>
                <th scope="col">Ações</th>
               
            </tr>
        </thead>
        <tbody>
            @if(Model != null)
            {

			@foreach (var emp in Model)
			{
                <tr>
                    <th scope="row">@emp.Recebedor</th>
                    <td>@emp.Fornecedor</td>
                    <td>@emp.LivroEmprestado</td>
                    <td>@emp.DataUltimaAtualizacao</td>
                        <th>
                            <a asp-controller="Emprestimo" asp-action="Editar" asp-route-id="@emp.Id" class="btn btn-warning mx-2"><i class="bi bi-pencil mx-1"></i>Editar</a>
                            <a asp-controller="Emprestimo" asp-action="Excluir" asp-route-id="@emp.Id" class="btn btn-danger mx-2"><i class="bi bi-trash3 mx-1"></i>Excluir</a>
                        </th>
                </tr>

			}
            
            }
        </tbody>
</table>
   </div>


<p>By! Create edit delete and update</p>
