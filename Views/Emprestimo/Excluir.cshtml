@model EmprestimoModel
@*
*@
@{
    ViewData["Title"] = "Excluir Emprestimo";
}
<div class="container" bg-dark p-5 rounded-5>
    <div class="mb-5 text-center">
        <h1 class="text-dark">Excluir Empréstimos</h1>
    </div>

    <h2 class="text-black">Tem certeza que deseja excluir o registro abaixo?</h2>

    <form method="post" asp-controler="Emprestimo" asp-action="Excluir">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label for="Recebedor" class="form-label">Recebedor</label>
            <input type="text" class="form-control text-dark" asp-for="Recebedor" id="Recebedor" placeholder="Quem está recebendo o livro?" disabled>
            <span class="text-danger" asp-validation-for="Recebedor"></span>
        </div>
        <div class="mb-3">
            <label for="Fornecedor" class="form-label">Fornecedor</label>
            <input type="text" class="form-control text-dark" asp-for="Fornecedor" id="Fornecedor" placeholder="Quem está emprestando o livro?" disabled>
            <span class="text-danger" asp-validation-for="Fornecedor"></span>
        </div>
        <div class="mb-3">
            <label for="Livro" class="form-label">Livro</label>
            <input type="text" class="form-control text-dark" asp-for="LivroEmprestado" id="Livro" placeholder="Qual nome do livro?" disabled>
            <span class="text-danger" asp-validation-for="LivroEmprestado"></span>
        </div>

        <div class="d-flex gap-5 mt-5">
            <button type="submit" class="btn btn-danger w-50">Excluir</button>
            <a class="btn btn-primary w-50" asp-controller="Emprestimo" asp-action="Index">Voltar</a>
        </div>
    </form>
</div>